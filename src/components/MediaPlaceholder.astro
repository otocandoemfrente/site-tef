---
// Placeholder visual para foto/vídeo ainda não disponível — ver
// prompt-claude-code-site-tef.md, seção "Assets e imagens": bloco na cor
// --color-border com o texto "Foto: [descrição]" centralizado.
interface Props {
  label: string;
  kind?: 'Foto' | 'Vídeo' | 'Retrato' | 'QR Code';
  ratio?: string;
}

const { label, kind = 'Foto', ratio = '16 / 9' } = Astro.props;
---

<div class="media-placeholder" style={`aspect-ratio: ${ratio};`} role="img" aria-label={`${kind}: ${label}`}>
  <span>{kind}: {label}</span>
</div>

<style>
  .media-placeholder {
    /* Preenchimento sutil (não igual à borda, senão a moldura de 1px some) + moldura reta de 1px. */
    background: color-mix(in srgb, var(--color-border) 40%, var(--color-bg));
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  /* Mesma linguagem de hover do resto do site (leve escala) — dá vida ao placeholder mesmo sem ser clicável. */
  .media-placeholder:hover {
    transform: scale(1.015);
    background: color-mix(in srgb, var(--color-border) 60%, var(--color-bg));
  }
</style>
