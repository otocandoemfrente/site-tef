---
import type { Locale } from '../i18n/nav';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BrazilMap from '../components/BrazilMap.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import AtosColunas from '../components/AtosColunas.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import heroImage from '../assets/images/hero-estudantes-oficina.jpg';
import quemSomosImage from '../assets/images/quem-somos-turma.webp';
import premioLedVideoPoster from '../assets/images/premio-led-video-poster.jpg';
import onuImage from '../assets/images/onu-discurso.png';
import kauanImage from '../assets/images/kauan-retrato.jpg';
import atuacaoPreviewImage from '../assets/images/atuacao-preview-turma.jpg';
import ingohLogo from '../assets/images/INGOH-MARCA.webp';
import qrPixImage from '../assets/images/QR_code.jpg';
import { getContent } from '../i18n/content';
import { prefix } from '../i18n/locale';

// Idioma da página (pt | en): as rotas em src/pages/ e src/pages/en/ só passam esta prop.
const locale: Locale = (Astro.props as { locale?: Locale }).locale ?? 'pt';
const en = locale === 'en';
const pre = prefix(locale);
const c = getContent(locale);
const home = c.home;
const jornadaPage = c.jornada;
const numeros = c.numeros;
const atuacaoPage = c.atuacao;
const premios = c.premios;
const midia = c.midia;
const reconhecimentosContent = c.reconhecimentos;

const { hero, quemSomos, atosHome, story, ctaFinal } = home;

// --- Números (fonte única: numeros.json — a mesma usada na linha do hero, nos
// cards de Atuação e na seção de números, para nunca haver dois valores diferentes na página) ---
const [estudantesItem, escolasItem, estadosItem] = numeros.itens as { valor: string; label: string; nota: string }[];
const estadosCurto = estadosItem?.valor.match(/^\d+/)?.[0] ?? estadosItem?.valor;

// --- "Quem somos": divide o título no trecho contínuo com destaque de marcador ---
function splitHighlight(text: string, highlight: string) {
  const idx = text.indexOf(highlight);
  if (idx === -1) return [{ text, highlighted: false }];
  return [
    { text: text.slice(0, idx), highlighted: false },
    { text: highlight, highlighted: true },
    { text: text.slice(idx + highlight.length), highlighted: false },
  ];
}
const quemSomosTitleParts = splitHighlight(quemSomos.title, quemSomos.highlight);

// --- Áreas da Jornada (OVO primeiro, depois 01–06) — ordem fixa, não alfabética ---
const areas = c.areas;
// O ticker não repete o OVO — só as seis áreas, como no protótipo aprovado.
const tickerNames = areas.slice(1).map((a) => a.tabLabel.toUpperCase());

// --- Prévia de Reconhecimentos: décima oitava rodada — deixou de ser quatro faixas editoriais
// de peso igual e virou um único grande destaque (Prêmio LED, com o vídeo real da premiação) +
// o link pra página completa, a pedido explícito ("não apenas mais um item da lista... os
// demais reconhecimentos continuam podendo aparecer na página específica"). Watson/The Wall
// saíram da Home (continuam intactos em /reconhecimentos, que lê `premios.json`/`midia.json`
// direto, sem depender deste array). Vigésima segunda rodada: a ONU voltou como um segundo
// destaque, no mesmo modelo do LED — lê `destaques.onu` direto de reconhecimentos.md, mesma
// fonte já usada por /reconhecimentos, sem duplicar conteúdo.
const jornalNacional = midia.find((m: { veiculo: string }) => m.veiculo === 'Jornal Nacional');
const [premioLed] = premios;
const { onu } = reconhecimentosContent.destaques;

// CTA final: duas frases, cada uma na própria linha ("Seja alguém que acredita." / "Vamos juntos!").
const ctaTitleLines = ctaFinal.title.split(/(?<=\.)\s+/);
// Vigésima terceira rodada: o texto institucional da ONU é bem mais longo que o do LED (o único
// outro card desta seção) e deixava os dois boxes com alturas bem diferentes — a pedido explícito
// ("se necessário, cortar parte do texto explicativo da ONU"), a prévia da Home usa só a primeira
// frase, o bastante pra situar o reconhecimento sem o parágrafo inteiro de contexto (a lista de
// países/organizações do evento). O texto completo continua intacto em reconhecimentos.md e
// aparece por inteiro em /reconhecimentos — só esta prévia resume.
const onuTextoResumo = onu.texto.split('. ')[0] + '.';

// Faixa "Parceiros e apoiadores" — logos importados à parte (o JSON/markdown de conteúdo não
// pode importar assets do Astro) e casados por nome, mesmo padrão já usado pras fotos de
// pessoas em faca-parte.astro. Só o INGOH existe hoje; adicionar um novo parceiro no futuro é
// só importar o arquivo, adicionar uma entrada aqui e um item em `reconhecimentosPreview.partners`
// no home.md — nunca inventar um logo/parceiro que não tenha asset real.
const partnerLogos: Record<string, ImageMetadata> = {
  'INGOH — Instituto Goiano de Oncologia e Hematologia': ingohLogo,
};

---

<Layout title={home.title} description={home.description} locale={locale}>
  <section class="hero">
    <Image src={heroImage} alt={hero.imageAlt} class="hero__media" widths={[768, 1280, 2000]} sizes="100vw" width={2000} format="webp" />
    {/* Véu azul translúcido sobre a foto — garante contraste do texto claro, na cor da marca em vez de preto neutro. */}
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="container hero__content">
      <p class="stat-line">
        <span>{en ? 'Since' : 'Desde'} {home.about.foundingYear}</span>
        <span aria-hidden="true">·</span>
        <span>{estadosCurto} {en ? 'states' : 'estados'}</span>
        <span aria-hidden="true">·</span>
        <span>{escolasItem?.valor} {en ? 'public schools' : 'escolas públicas'}</span>
      </p>
      <h1 class="hero__title">
        {hero.missionLines.map((line: string) => <span class="hero__line">{line}</span>)}
      </h1>
    </div>
  </section>

  <section class="ticker-section" aria-label={en ? 'Learning Journey fields' : 'Áreas da Jornada Pedagógica'}>
    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {
          [0, 1].map(() => (
            <span class="ticker__group">
              {tickerNames.map((name: string) => (
                <span class="ticker__item">{name}</span>
              ))}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="quem-somos" aria-labelledby="quem-somos-heading">
    <div class="container">
      {/* Rótulo fora do grid de 2 colunas de propósito — se ficasse dentro da coluna
          esquerda, empurrava só o título para baixo e desalinhava do texto à direita. */}
      <p class="caption kicker kicker--muted">{quemSomos.kicker}</p>
      <div class="quem-somos__grid">
        <h2 id="quem-somos-heading" class="quem-somos__title">
          {
            quemSomosTitleParts.map((part) =>
              part.highlighted ? <span class="accent-mark">{part.text}</span> : part.text,
            )
          }
        </h2>
        {/* A foto ocupa o lugar dos três parágrafos de apoio (a pedido): título à esquerda, foto ao lado. */}
        <figure class="quem-somos__foto" data-reveal-block>
          <Image src={quemSomosImage} alt={en ? 'Uniformed students and young women volunteers smiling and flashing peace signs, gathered in a classroom' : 'Estudantes uniformizados e jovens voluntárias sorrindo e fazendo sinal de paz, reunidos numa sala de aula'} class="quem-somos__foto-img" widths={[480, 768, 1100]} sizes="(min-width: 720px) 50vw, 94vw" />
        </figure>
      </div>
    </div>
  </section>

  <section class="numbers" aria-labelledby="numbers-heading">
    <div class="container numbers__layout">
      <div class="numbers__col">
        <h2 id="numbers-heading" class="visually-hidden">{en ? 'Impact numbers' : 'Números de impacto'}</h2>
        <ul class="numbers__grid" data-count-group>
          <li class="stat">
            <span class="stat__value" data-count>{estudantesItem?.valor}</span>
            <span class="stat__label">
              {estudantesItem?.label}
              <span class="stat__note">{estudantesItem?.nota}</span>
            </span>
          </li>
          <li class="stat">
            <span class="stat__value" data-count>{escolasItem?.valor}</span>
            <span class="stat__label">
              {escolasItem?.label}
              <span class="stat__note">{escolasItem?.nota}</span>
            </span>
          </li>
          <li class="stat">
            <span class="stat__value" data-count>{estadosItem?.valor}</span>
            <span class="stat__label">
              {estadosItem?.label}
              <span class="stat__note">{estadosItem?.nota}</span>
            </span>
          </li>
        </ul>
        <p class="caption numbers__definition">{numeros.definicao}</p>
        <p class="numbers__updated">
          {en ? 'Cumulative numbers since' : 'Números acumulados desde'} {numeros.acumuladoDesde} · {en ? 'updated on' : 'atualizados em'} <time>{numeros.atualizadoEm}</time>
        </p>
      </div>
      <div class="numbers__col numbers__col--map">
        <BrazilMap />
      </div>
    </div>
  </section>

  <section class="atuacao-preview" aria-labelledby="atuacao-heading">
    <div class="container">
      <div class="atuacao-preview__box">
        <Image src={atuacaoPreviewImage} alt="" class="atuacao-preview__media" widths={[768, 1280, 2000]} sizes="100vw" width={2000} format="webp" />
        {/* Mesmo véu azul translúcido do hero — garante contraste do texto claro sobre a foto. */}
        <div class="atuacao-preview__veil" aria-hidden="true"></div>

        <div class="atuacao-preview__content">
          <div class="section-heading">
            <h2 id="atuacao-heading">{en ? 'Our Work' : 'Atuação'}</h2>
            <a href={`${pre}/atuacao`} class="section-heading__link">{en ? 'See all of Our Work →' : 'Ver Atuação completa →'}</a>
          </div>
          <p class="atuacao-preview__texto">{atuacaoPage.abertura}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="atos-home" aria-labelledby="atos-home-heading">
    <div class="container">
      <h2 id="atos-home-heading" class="kicker" data-reveal-words>{atosHome.kicker}</h2>
      <p class="atos-home__instrucao">{atosHome.instrucao}</p>
      <AtosColunas itens={jornadaPage.atos.itens} />
    </div>
  </section>

  <section class="testimonial" aria-labelledby="testimonial-heading">
    <div class="container">
      <p class="caption kicker" id="testimonial-heading">{en ? '03 · Featured testimonial' : '03 · Depoimento em destaque'}</p>
      <QuoteBlock quote={story.pullQuote} name={story.name} role={story.role} portraitAlt={story.portraitAlt} portrait={kauanImage} />
    </div>
  </section>

  <section class="reconhecimentos-preview" aria-labelledby="reconhecimentos-heading">
    <div class="container">
      <div class="reconhecimentos-preview__intro">
        <p id="reconhecimentos-heading" class="caption kicker">{home.reconhecimentosPreview.kicker}</p>
      </div>

      {/*
        O Prêmio LED é o reconhecimento mais importante recebido pelo Tocando em Frente — a
        pedido explícito, deixou de ser "mais um item da lista" (uma faixa entre quatro, todas do
        mesmo peso) e virou o grande destaque da seção, com o vídeo real da premiação tocando
        direto na própria Home (nunca um embed do YouTube/Instagram). Reaproveita a MESMA
        linguagem visual das faixas antigas (fundo --color-primary-dark, texto --color-accent,
        grid de duas colunas) — não é um componente novo do zero, é a evolução natural do que já
        existia, só com o vídeo no lugar da foto estática e mais espaço pro contexto.
      */}
      <article class="reconhecimentos-band reconhecimentos-band--media-first reconhecimento-destaque" data-reveal-block>
        <div class="reconhecimentos-band__media">
          <VideoPlayer
            src="/videos/premio-led-luz-na-educacao.mp4"
            poster={premioLedVideoPoster}
            posterAlt={`${en ? 'Video' : 'Vídeo'}: ${premioLed.titulo}`}
            title={premioLed.titulo}
          />
        </div>
        <div class="reconhecimentos-band__body">
          <p class="caption reconhecimentos-band__kicker">{premioLed.ano}</p>
          <h3>{premioLed.titulo}</h3>
          <p class="reconhecimentos-band__sub">{premioLed.instituicao}</p>
          <p class="reconhecimento-destaque__texto">{premioLed.texto}</p>
          {jornalNacional?.link && (
            <a class="reconhecimentos-band__link" href={jornalNacional.link} target="_blank" rel="noopener noreferrer">
              {en ? 'See the Jornal Nacional coverage →' : 'Ver cobertura no Jornal Nacional →'}
            </a>
          )}
        </div>
      </article>

      <article class="reconhecimentos-band reconhecimentos-band--media-first reconhecimento-destaque" data-reveal-block>
        <div class="reconhecimentos-band__media">
          <VideoPlayer
            src="/videos/onu-discurso.mp4"
            poster={onuImage}
            posterAlt={`${en ? 'Video' : 'Vídeo'}: ${onu.titulo}`}
            title={onu.titulo}
          />
        </div>
        <div class="reconhecimentos-band__body">
          <p class="caption reconhecimentos-band__kicker">{onu.ano}</p>
          <h3>{onu.titulo}</h3>
          <p class="reconhecimentos-band__sub">{onu.instituicao}</p>
          <p class="reconhecimento-destaque__texto">{onuTextoResumo}</p>
        </div>
      </article>

      <a href={`${pre}/reconhecimentos`} class="btn btn-outline-dark reconhecimentos-cta">{en ? 'See all recognition →' : 'Ver todos os reconhecimentos →'}</a>

      <div class="partners" data-reveal-block>
        <p class="kicker kicker--muted">{home.reconhecimentosPreview.partnersKicker}</p>
        <div class="partners__grid">
          {
            home.reconhecimentosPreview.partners.map((partner: { nome: string }) =>
              partnerLogos[partner.nome] ? (
                <div class="partners__item">
                  <Image src={partnerLogos[partner.nome]} alt={partner.nome} class="partners__logo" widths={[200, 320, 440]} sizes="220px" />
                </div>
              ) : null
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="cta-final" aria-labelledby="cta-final-heading">
    <div class="container cta-final__inner">
      <div class="cta-final__intro">
        <h2 id="cta-final-heading">{ctaTitleLines.map((line: string) => <span class="cta-final__line">{line}</span>)}</h2>
        <p>{ctaFinal.text}</p>
      </div>

      <div class="cta-final__actions-col">
        <div class="cta-final__actions">
          <a class="btn btn-dark" href={ctaFinal.primaryHref} target="_blank" rel="noopener noreferrer">{ctaFinal.primaryLabel}</a>
          <a class="btn btn-outline-dark" href={ctaFinal.secondaryHref} target="_blank" rel="noopener noreferrer">{ctaFinal.secondaryLabel}</a>
        </div>

        <div class="cta-final__qr">
          <div class="cta-final__qr-backdrop">
            <Image src={qrPixImage} alt={en ? 'Pix QR Code — Associação Tocando em Frente' : 'QR Code Pix — Associação Tocando em Frente'} class="cta-final__qr-image" width={280} />
          </div>
          <p class="caption cta-final__qr-caption">{ctaFinal.qrText}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  section {
    /* Respiro maior entre seções — escala com a viewport em vez de um valor fixo só. */
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }

  section + section {
    border-top: 1px solid var(--color-border);
  }

  /* Hero — foto real de fundo com véu azul translúcido, texto claro alinhado à esquerda */
  .hero {
    position: relative;
    border-top: none;
    overflow: hidden;
    min-height: min(82vh, 44rem);
    display: flex;
    align-items: center;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem) clamp(4rem, 3rem + 4vw, 7rem);
  }

  .hero :global(.hero__media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
    Véu na cor primária da marca (em vez de preto neutro) — sempre-Astro
    otimiza a foto (WebP, redimensionada), o véu garante contraste do texto
    claro por cima dela em qualquer trecho da imagem.
  */
  .hero__veil {
    position: absolute;
    inset: 0;
    /* Azul mais escuro — a mesma cor do bloco da Jornada Pedagógica, não o azul primário. */
    background: color-mix(in srgb, var(--color-primary-dark) 78%, transparent);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: left;
  }

  /*
    O slogan é o elemento dominante da página: escala por vw para ocupar quase
    toda a largura nas 3 linhas fixas, peso mais leve (500) que o h1 padrão (700),
    e entrelinha apertada para as linhas lerem como um bloco só. Claro porque
    agora fica sobre o véu azul da foto, não mais sobre o off-white da página.
  */
  .hero__title {
    color: var(--color-bg);
    font-size: clamp(2.75rem, 9.2vw, 8.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.035em;
    display: flex;
    flex-direction: column;
  }

  .hero__line {
    display: block;
  }

  .stat-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: rgba(250, 248, 244, 0.8);
  }

  /* Faixa do ticker — seção própria, fina, fundo padrão da página (não faz parte do hero) */
  .ticker-section {
    padding-block: 0;
    border-top: none;
  }

  .ticker {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
    padding-block: 0.85rem;
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 32s linear infinite;
  }

  .ticker__group {
    display: flex;
    align-items: center;
    flex: none;
  }

  .ticker__item {
    flex: none;
    text-transform: uppercase;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    padding-inline: 1rem;
    white-space: nowrap;
  }

  .ticker__item:not(:last-child)::after {
    content: '—';
    margin-left: 2rem;
    color: var(--color-border);
  }

  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .atos-home__instrucao {
    margin: 0.75rem 0 2rem;
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
  }

  /* Quem somos — sem borda própria: a faixa do ticker logo acima já fecha com border-bottom. */
  .quem-somos {
    border-top: none;
  }

  /* Foto real da turma, ao lado do título (no lugar dos parágrafos): proporção original 4/3, moldura reta de 1px. */
  .quem-somos__foto {
    margin: 0;
  }

  .quem-somos__foto-img {
    display: block;
    width: 100%;
    height: auto;
    /* Recorte um pouco mais horizontal (3/2): corta um pouco em cima e embaixo; o foco em 46% mantém os rostos. */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center 46%;
    border: 1px solid var(--color-border);
  }

  .quem-somos__grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 2rem;
  }

  /*
    O texto do Quem somos agora é uma frase longa (a tradução de "Tocando em Frente reimagines middle school…"):
    em --text-h2 (40px) ocupava 11 linhas e passava muito da altura da foto. Fonte menor e linha um pouco mais
    larga pra acompanhar a foto (~8 linhas em 1024px).
  */
  .quem-somos__title {
    max-width: 30rem;
    margin: 0;
    font-size: clamp(1.5rem, 1.05rem + 1.5vw, 2.25rem);
    line-height: 1.2;
  }

  /* Título e foto lado a lado a partir de 720px, com o título centralizado na vertical em relação à foto. */
  @media (min-width: 720px) {
    .quem-somos__grid {
      align-items: center;
      grid-template-columns: repeat(var(--grid-columns), 1fr);
      column-gap: var(--grid-gap);
    }

    .quem-somos__grid > :first-child {
      grid-column: span 5;
    }

    .quem-somos__grid > .quem-somos__foto {
      grid-column: 7 / span 6;
    }
  }

  /*
    Seção de Atuação: mesma técnica do hero (foto real de fundo + véu azul translúcido, texto
    claro por cima) — a pedido explícito de usar a foto de turma da pasta de assets "no estilo
    da primeira foto da home". Décima terceira rodada — deixou de ser full-bleed (a pedido
    explícito, "a foto ocupando a tela inteira é demais"): a seção voltou a ser uma seção comum
    (respiro/borda padrão do `section` genérico, sem o `overflow:hidden`/`padding` especiais de
    antes) e o conjunto foto+véu+conteúdo virou uma caixa contida (`.atuacao-preview__box`) dentro
    do `.container`, com espaço da página off-white visível ao redor — o efeito de "mais cheio,
    menos vazio" pedido vem de conter a composição numa caixa do tamanho do próprio conteúdo, não
    mais de uma faixa do tamanho do hero com foto sobrando acima/abaixo dele.
  */
  .atuacao-preview__box {
    position: relative;
    overflow: hidden;
    /*
      Exceção deliberada e única no site à regra "sem arredondamento em lugar nenhum" (ver
      Direção visual → "Refinamento: reto, elegante, institucional"). Pedido explícito do
      usuário, feito ciente do conflito com essa regra — por isso um valor literal aqui, não
      `--radius-sm`/`--radius-md` (ambos travados em `0` de propósito, compartilhados por todo
      botão/card/moldura do resto do site; mudar qualquer um dos dois arredondaria a página
      inteira, não só esta caixa).
    */
    border-radius: 1.75rem;
  }

  .atuacao-preview__box :global(.atuacao-preview__media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
      Décima segunda rodada — a pedido explícito ("o texto ainda fica meio perdido na foto"): um
      leve desfoque na própria foto, não só o véu mais escuro (rodada anterior), separa melhor o
      texto/círculo brancos do fundo, que tem bastante detalhe de alto contraste (quadros na
      parede, objetos coloridos) competindo com as letras. `transform: scale()` compensa o
      encolhimento óptico que `blur()` causa nas bordas (a borda da imagem "puxaria" pixels de
      fora do próprio elemento, ficando com uma franja mais clara/transparente sem isso) — mesmo
      efeito colateral documentado em qualquer uso de `filter: blur()` sobre um elemento que
      preenche a borda do próprio container.
    */
    filter: blur(4px);
    transform: scale(1.04);
  }

  .atuacao-preview__veil {
    position: absolute;
    inset: 0;
    /*
      Terceira rodada — a pedido explícito de "azul mais escuro, vibrante" mas "tentar deixar a
      imagem" visível: em vez de só subir a opacidade (que a rodada anterior já tinha levado a
      90%, quase apagando a foto), a MISTURA em si ficou mais escura/rica — `--color-primary-dark`
      combinado com uma fatia de `--color-text` (o azul-marinho mais escuro do site, não uma cor
      nova) — e a opacidade voltou a descer um pouco, deixando a foto reaparecer por baixo. O tom
      resultante ainda é mais escuro/contrastante que a rodada anterior contra os elementos
      brancos por cima (círculo, avião, título), só que sem depender de cobrir a foto quase por
      inteiro pra isso.
    */
    background: color-mix(
      in srgb,
      color-mix(in srgb, var(--color-primary-dark) 75%, var(--color-text) 25%) 84%,
      transparent
    );
  }

  .atuacao-preview__content {
    position: relative;
    z-index: 1;
    /* A caixa não herda mais o padding-block da seção (a foto não preenche mais a seção
       inteira) — o respiro do conteúdo por cima da foto agora vive aqui. */
    padding: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* Atuação simplificada: título, uma frase e o link (sem o círculo animado). */
  .atuacao-preview__texto {
    margin: clamp(1rem, 0.75rem + 1vw, 1.75rem) 0 0;
    max-width: 46ch;
    font-size: var(--text-h3);
    line-height: 1.3;
    color: rgba(250, 248, 244, 0.9);
  }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* Letras brancas sobre o novo fundo — antes herdavam a cor padrão (escura) da página.
     Terceira rodada — título maior, a pedido explícito ("Atuação deve ser maior como um
     título"): esta seção já tem o mesmo tratamento fotográfico de tela cheia do hero, então o
     `--text-h2` genérico (herdado de `.section-heading h2`, pensado pra um kicker de seção
     comum) lia pequeno demais nesse contexto — subiu pra `--text-hero`, a mesma escala usada nos
     H1 das páginas internas. */
  .atuacao-preview .section-heading h2 {
    color: var(--color-bg);
    font-size: var(--text-hero);
    font-weight: 600;
  }

  .section-heading__link {
    font-size: var(--text-caption);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .atuacao-preview .section-heading__link {
    color: var(--color-bg);
  }

  /* O :hover global (a:hover { color: var(--color-primary-dark) }) ficaria escuro sobre escuro
     aqui — mesma exceção de accent-on-dark já documentada em global.css. */
  .atuacao-preview .section-heading__link:hover {
    color: var(--color-accent);
  }

  /* Números — coluna esquerda (números empilhados) + coluna direita (mapa) */
  .numbers__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .numbers__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .numbers__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .stat:first-child {
    padding-top: 0;
    border-top: none;
  }

  .stat__value {
    font-weight: 700;
    font-size: clamp(2.5rem, 2.1rem + 1.5vw, 3.5rem);
    line-height: 1;
    letter-spacing: var(--tracking-h2);
    color: var(--color-primary);
  }

  .stat__label {
    font-size: var(--text-body);
    color: var(--color-text);
  }

  .stat__note {
    display: block;
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
  }

  .numbers__definition {
    max-width: var(--measure);
  }

  /* Data de atualização visível (não só uma legenda miúda): linha própria, com divisória, em peso 600. */
  .numbers__updated {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-text);
  }

  .numbers__col--map {
    display: flex;
    align-items: center;
  }

  @media (min-width: 720px) {
    .numbers__layout {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
      column-gap: var(--grid-gap);
      align-items: center;
    }

    .numbers__col {
      grid-column: span 6;
    }

    .numbers__col--map {
      grid-column: span 6;
    }
  }

  /*
    Reconhecimentos preview — décima oitava rodada: de "arquivo editorial de quatro grandes
    momentos" pra um único grande destaque (Prêmio LED, o reconhecimento mais importante já
    recebido) + link pra página completa, a pedido explícito de deixar claro que não é "mais um
    item da lista". Vigésima segunda rodada: o título grande fora do card
    (`.reconhecimentos-preview__led-title`) saiu por completo, a pedido explícito ("tirar o
    Prêmio LED que tá pra fora do card") — a introdução da seção voltou a ser só o kicker, e o
    nome de cada reconhecimento passou a existir só dentro do próprio card.
  */
  .reconhecimentos-preview__intro {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /*
    A faixa do LED (e, agora, a da ONU) reaproveita 100% o visual já estabelecido pras faixas
    antigas — fundo azul (--color-primary-dark) com letras em amarelo (--color-accent), a mesma
    exceção já documentada em global.css pra usar --color-accent como cor de texto sobre
    --color-primary-dark. Não é um componente novo, é a mesma peça — ver `.reconhecimento-destaque`
    logo abaixo pros ajustes de tipografia compartilhados pelos dois cards.
  */
  .reconhecimentos-band {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--color-primary-dark);
    background: var(--color-primary-dark);
  }

  /*
    min-width:0 no item de grid é necessário aqui — sem isso, o min-width:auto padrão de um
    item de grid, combinado com o aspect-ratio do filho, faz o conteúdo "vazar" da própria
    coluna (bug real, documentado quando esta faixa ainda mostrava fotos: estourava ~49px além
    do container). width/height 100% explícitos no `.video-player` (ver VideoPlayer.astro)
    garantem que os dois lados fiquem travados antes de qualquer aspect-ratio entrar em jogo.
  */
  .reconhecimentos-band__media {
    min-width: 0;
  }

  .reconhecimentos-band__media :global(.video-player) {
    width: 100%;
    height: 100%;
  }

  .reconhecimentos-band__body {
    min-width: 0;
    padding: clamp(1.75rem, 1.4rem + 1.8vw, 3.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    justify-content: center;
  }

  .reconhecimentos-band__kicker {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-accent);
  }

  .reconhecimentos-band__body h3 {
    font-size: var(--text-h2);
    color: var(--color-accent);
  }

  .reconhecimentos-band__sub {
    color: var(--color-accent);
  }

  .reconhecimentos-band__link {
    width: fit-content;
    font-weight: 500;
    text-decoration: none;
    margin-top: 0.4rem;
    color: var(--color-accent);
  }

  /*
    Compartilhado pelos dois destaques (LED e ONU) — o nome de cada reconhecimento é o título de
    verdade do card (sem duplicar em nenhum lugar fora dele), numa legenda institucional compacta,
    não uma manchete gigante. `__texto` é o parágrafo institucional (`premios.json`/
    `reconhecimentos.md`) em tom secundário — mesmo "branco cru com alpha" já usado em texto
    secundário sobre fundo escuro no resto do site (Ciclo de Atuação, SustentacaoMapa,
    AtuacaoMap), não uma cor nova.
  */
  .reconhecimento-destaque .reconhecimentos-band__body {
    gap: 0.85rem;
  }

  /*
    Os dois cards (LED e ONU) precisam ter o mesmo tamanho — pedido explícito. O texto do LED
    (com o link "Ver cobertura no Jornal Nacional") naturalmente ocupa mais altura que o da ONU
    (já resumido, ver `onuTextoResumo` acima). Em vez de inflar o texto da ONU artificialmente,
    um min-height no card garante os dois do mesmo tamanho — a coluna do vídeo e a do texto já
    esticam pra preencher a altura do grid (comportamento padrão do CSS Grid, confirmado
    medindo `getBoundingClientRect()`: as duas colunas passam a ter a mesma altura no card mais
    curto, sem distorcer o vídeo — o `object-fit` do player cuida disso). Só no desktop
    (min-width: 720px, onde os dois viram colunas lado a lado) — no mobile os dois já empilham
    (vídeo em cima do texto) e ficam bem mais altos que esse piso de qualquer forma.
  */
  @media (min-width: 720px) {
    .reconhecimento-destaque {
      min-height: 24.5rem;
    }
  }

  .reconhecimento-destaque .reconhecimentos-band__body h3 {
    font-size: var(--text-h3);
  }

  .reconhecimento-destaque__texto {
    color: rgba(250, 248, 244, 0.85);
  }

  /* Segundo card (ONU) empilhado abaixo do primeiro (LED), mesmo respiro do resto da seção. */
  .reconhecimento-destaque + .reconhecimento-destaque {
    margin-top: clamp(1.5rem, 1.1rem + 1.5vw, 2.5rem);
  }

  @media (min-width: 720px) {
    /* Foto primeiro no DOM → coluna da foto um pouco menor que a do texto. Texto primeiro no
       DOM → coluna da foto um pouco maior — pequena variação de proporção entre faixas, não
       repetindo a mesma grade nas quatro (pedido explícito: nada de blocos idênticos). */
    .reconhecimentos-band--media-first {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    }

    .reconhecimentos-band--text-first {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }

  .reconhecimentos-cta {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /*
    Parceiros e apoiadores — faixa nova, substitui o PendingNote que existia aqui. Divisória de
    1px acima (mesma linguagem de "grade como elemento gráfico" já documentada em Direção
    visual) separa a faixa do CTA "Ver todos os reconhecimentos" logo acima, sem precisar de uma
    seção `<section>` própria. Kicker usa `.kicker--muted` (cinza, não a cor primária) — não é
    uma seção numerada nova, só um rótulo discreto pra um grupo de logos.
  */
  .partners {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
    border-top: 1px solid var(--color-border);
  }

  .partners__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .partners__item {
    display: flex;
    align-items: center;
  }

  /*
    Altura fixa, largura livre — o logo mantém a proporção original (sem distorção) e todos os
    parceiros futuros ficam na mesma escala visual entre si, independente da proporção própria
    de cada marca. `width: auto` explícito garante que a largura venha só da proporção real da
    imagem, nunca do atributo HTML width que o astro:assets já embute no <img>.
  */
  .partners__logo {
    display: block;
    width: auto;
    height: clamp(2.75rem, 2.25rem + 2vw, 3.75rem);
  }

  /*
    CTA final — vigésima rodada: de "tudo empilhado numa coluna só ao lado do título" pra duas
    áreas de fato equilibradas — esquerda (título + uma única frase) e direita (ações: botões +
    QR), a pedido explícito. Mesma identidade de sempre (fundo --color-accent, texto
    --color-on-accent, sem cantos/sombra nova) — só a diagramação mudou.
  */
  .cta-final {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-top: none;
    /* Vigésima primeira rodada — faixa compactada, a pedido explícito ("eliminar o espaço
       vertical que ficou sobrando"): com o conteúdo já mais organizado (duas colunas, QR maior),
       o respiro genérico de `section` (até 6.5rem) sobrava espaço vazio acima/abaixo. Reduzido,
       não zerado — ainda claramente mais respirado que uma seção de texto denso. */
    padding-block: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .cta-final__inner {
    display: grid;
    grid-template-columns: 1fr;
    /* Respiro generoso entre as duas áreas — pedido explícito ("bastante respiro, espaço
       negativo") — escala com a viewport em vez de um valor fixo só. */
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .cta-final h2 {
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .cta-final__line {
    display: block;
  }

  .cta-final__intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Largura pensada pra frase renderizar em ~2–3 linhas nos tamanhos de tela mais comuns,
     equilibrada com o título acima — nem uma linha só (muito larga, perde a leitura de bloco),
     nem 4+ linhas (estreita demais). */
  .cta-final__intro p {
    max-width: 30rem;
  }

  /*
    Área de ações — botões em cima, QR embaixo, os dois alinhados à esquerda (mesma convenção do
    resto do site: "nada flutuando no meio do espaço em branco"). Nunca ao lado do texto nem
    entre os dois parágrafos — pedido explícito.
  */
  .cta-final__actions-col {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .cta-final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /*
    Vigésima primeira rodada — QR + texto viram um bloco horizontal, pedido explícito
    ("[ QR CODE ] Aponte a câmera..."), não mais QR com legenda embaixo. `align-items:center`
    centraliza o texto verticalmente contra o QR, como pedido.
  */
  .cta-final__qr {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /*
    Sem moldura nem contorno — pedido explícito e literal ("não colocar borda preta", "não criar
    moldura", "não colocar dentro de um quadrado com contorno"). `.cta-final__qr-backdrop` é só
    um fundo branco simples (sem `border`, sem sombra) que o próprio pedido permite como exceção
    pra garantir contraste contra o amarelo — o QR em si já nasce com fundo branco embutido
    (mesmo arquivo usado em `faca-parte.astro`), então esse fundo é sobretudo uma rede de
    segurança pra o quiet zone nunca ficar justo demais com o amarelo ao redor, não uma moldura.
    `flex: none` — sem isso, o flex row com o texto ao lado poderia espremer o QR pra caber.
  */
  .cta-final__qr-backdrop {
    flex: none;
    display: inline-block;
    background: var(--color-bg);
    padding: 0.5rem;
  }

  /* Um pouco menor que a rodada anterior (12rem→9rem) — antes o QR tinha a coluna inteira só
     pra si; agora divide a linha com o texto ao lado, então precisa sobrar largura pra ele. */
  .cta-final__qr-image {
    display: block;
    width: min(9rem, 34vw);
    height: auto;
    aspect-ratio: 1 / 1;
  }

  .cta-final__qr-caption {
    color: var(--color-on-accent);
    max-width: 18rem;
  }

  @media (min-width: 720px) {
    .cta-final__inner {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
      column-gap: var(--grid-gap);
      align-items: center;
    }

    .cta-final__inner > .cta-final__intro {
      grid-column: span 6;
    }

    .cta-final__inner > .cta-final__actions-col {
      grid-column: span 6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
  }
</style>

