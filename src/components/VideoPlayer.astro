---
// Player de vídeo nativo (arquivo servido direto do site, nunca um embed do YouTube/Instagram)
// — thumbnail real + botão de play; o <video> só começa a carregar quando o usuário clica
// (preload="none", sem src em nenhum outro elemento antes disso), então a presença deste
// componente não pesa no carregamento da página que o contém. Sem controles nativos visíveis
// até o clique — eles apareceriam junto com a barra de progresso/volume do navegador por cima
// da nossa composição de capa+play, que é quem deve mandar na leitura visual antes de tocar.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localeFromUrl } from '../i18n/locale';

interface Props {
  src: string;
  poster: ImageMetadata;
  posterAlt: string;
  title: string;
  ratio?: string;
}

const { src, poster, posterAlt, title, ratio = '16 / 9' } = Astro.props;
const en = localeFromUrl(Astro.url) === 'en';
---

<div class="video-player" style={`aspect-ratio: ${ratio};`} data-video-player>
  <video class="video-player__video" src={src} preload="none" playsinline data-video-el></video>

  <Image
    src={poster}
    alt={posterAlt}
    class="video-player__poster"
    widths={[480, 768, 1200]}
    sizes="(min-width: 720px) 55vw, 100vw"
    data-video-poster
  />

  <button type="button" class="video-player__play" aria-label={`${en ? 'Watch' : 'Assistir'}: ${title}`} data-video-play>
    <span class="video-player__play-badge" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8.5 5.5v13l11-6.5z" fill="currentColor" /></svg>
    </span>
    <span class="video-player__play-label">{en ? 'Watch' : 'Assistir'}</span>
  </button>
</div>

<style>
  .video-player {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    background: var(--color-text);
  }

  .video-player__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    /* `contain`, não `cover` — garante que a proporção original do vídeo nunca seja alterada
       nem cortada, mesmo que o box de exibição não bata pixel a pixel com o vídeo real. */
    object-fit: contain;
    background: var(--color-text);
  }

  .video-player :global(.video-player__poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-player__play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    border: none;
    padding: 0;
    cursor: pointer;
    background: color-mix(in srgb, var(--color-text) 38%, transparent);
    transition: background-color 0.2s ease;
  }

  .video-player__play:hover,
  .video-player__play:focus-visible {
    background: color-mix(in srgb, var(--color-text) 52%, transparent);
  }

  /*
    Selo reto (nunca circular — "sem arredondamento em lugar nenhum" continua valendo aqui,
    sem precisar de exceção nova) com o triângulo de play dentro. Escala levemente no
    hover/foco, mesma linguagem de motion já usada em `.btn` no resto do site.
  */
  .video-player__play-badge {
    width: 4.25rem;
    height: 4.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    color: var(--color-text);
    transition: transform 0.2s ease;
  }

  .video-player__play:hover .video-player__play-badge,
  .video-player__play:focus-visible .video-player__play-badge {
    transform: scale(1.08);
  }

  .video-player__play-badge svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .video-player__play-label {
    color: var(--color-bg);
    font-weight: 600;
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .video-player.is-playing .video-player__poster,
  .video-player.is-playing .video-player__play {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-player]').forEach((wrap) => {
    const video = wrap.querySelector<HTMLVideoElement>('[data-video-el]');
    const playButton = wrap.querySelector<HTMLButtonElement>('[data-video-play]');
    if (!video || !playButton) return;

    playButton.addEventListener(
      'click',
      () => {
        wrap.classList.add('is-playing');
        // Controles nativos (pausar/avançar/volume/tela cheia) só aparecem depois do clique —
        // antes disso, é a capa + botão de play deste componente quem representa a interação.
        video.controls = true;
        video.play();
      },
      { once: true },
    );
  });
</script>
