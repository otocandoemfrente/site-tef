---
// Ícones outline simples (linha fina, currentColor) — mesmo espírito do QuoteIcon.astro,
// generalizado por nome pra não precisar de um componente novo por ícone.
export type IconName =
  | 'documento'
  | 'quadro'
  | 'conversa'
  | 'lupa'
  | 'escola'
  | 'livro'
  | 'mapa'
  | 'pessoa'
  | 'alerta'
  | 'crescimento'
  | 'estrela';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  // Documento com check — parceria formalizada.
  documento: '<rect x="5" y="4" width="14" height="17" rx="1.5"/><rect x="9" y="2" width="6" height="3.5" rx="1"/><path d="M8.5 12.5l2.3 2.3L15.5 10"/>',
  // Quadro com linhas de aula + tripé de apoio.
  quadro: '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M8 8.5h8M8 11.5h5"/><path d="M9 20l3-4 3 4"/>',
  // Dois balões de conversa sobrepostos.
  conversa:
    '<path d="M3.5 7.5A2.5 2.5 0 016 5h6a2.5 2.5 0 012.5 2.5v3A2.5 2.5 0 0114 13H9.5L7 15.5V13H6a2.5 2.5 0 01-2.5-2.5v-3z"/><path d="M11 14.5A2.5 2.5 0 0113.5 12h4a2.5 2.5 0 012.5 2.5v2a2.5 2.5 0 01-2.5 2.5H17l-2 2v-2h-.5a2.5 2.5 0 01-2.5-2.5v-2z"/>',
  // Lupa.
  lupa: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M19.5 19.5L15 15"/>',
  // Prédio com telhado + porta — escola.
  escola: '<path d="M4 21V10.5L12 5l8 5.5V21"/><path d="M3 21h18"/><path d="M10 21v-6h4v6"/>',
  // Livro aberto.
  livro:
    '<path d="M12 6.5c-1.9-1.3-4.3-2-6.8-2-.7 0-1.2.6-1.2 1.2v11.6c0 .7.5 1.2 1.2 1.2 2.5 0 4.9.7 6.8 2 1.9-1.3 4.3-2 6.8-2 .7 0 1.2-.5 1.2-1.2V5.7c0-.7-.5-1.2-1.2-1.2-2.5 0-4.9.7-6.8 2z"/><path d="M12 6.5v13"/>',
  // Pino de localização — cobertura geográfica (estados com Diretores Regionais).
  mapa: '<path d="M12 21s7-7.58 7-12A7 7 0 105 9c0 4.42 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/>',
  // Silhueta simples de pessoa — voluntários/Diretores Regionais.
  pessoa: '<circle cx="12" cy="8" r="3.2"/><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/>',
  // Triângulo de alerta — desafios da Teoria da Mudança.
  alerta: '<path d="M12 4L2.5 20h19L12 4z"/><path d="M12 10.5v3.5"/><circle cx="12" cy="17" r="0.9" fill="currentColor" stroke="none"/>',
  // Seta ascendente com barras — mudanças/desenvolvimento na Teoria da Mudança.
  crescimento: '<path d="M4 18l5.5-5.5 3.5 3.5 6.5-7"/><path d="M15 8.2h4.8V13"/>',
  // Estrela outline de cinco pontas — impacto na Teoria da Mudança.
  estrela: '<path d="M12 3.2l2.7 5.9 6.4.6-4.8 4.4 1.4 6.4L12 17.1l-5.7 3.4 1.4-6.4-4.8-4.4 6.4-.6L12 3.2z"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>

<style>
  /*
    Tamanho padrão de segurança: sem isso, um SVG sem width/height cai no padrão do
    navegador (~300px), só espremido pelo espaço disponível — foi exatamente o bug dos
    "ícones gigantes" na Atuação (o CSS de tamanho vivia no componente PAI, que nunca
    alcança o <svg> daqui por causa do escopo do Astro). Quem usa <Icon> deve mesmo assim
    definir o tamanho via :global(.classe-passada) no componente pai — isso aqui é só
    para nunca ficar gigante caso alguém esqueça.
  */
  svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
