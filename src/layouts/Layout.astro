---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { uiStrings, getLocaleSwitchHref, type Locale } from '../i18n/nav';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Caminho absoluto de uma imagem em /public para og:image (opcional — ainda não há assets reais). */
  ogImage?: string;
  /** Rodapé azul (padrão em todas as páginas; passe footerAzul={false} pra voltar ao rodapé claro). */
  footerAzul?: boolean;
}

const { title, description, locale = 'pt', ogImage, footerAzul = true } = Astro.props;
const strings = uiStrings[locale];
const htmlLang = locale === 'pt' ? 'pt-BR' : 'en';
const pageTitle = `${title} · Tocando Em Frente`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
// Versão equivalente no outro idioma (hreflang) — o mesmo cálculo do seletor PT | EN do cabeçalho.
const alternateURL = new URL(getLocaleSwitchHref(locale, Astro.url.pathname), Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={locale === 'pt' ? 'pt-BR' : 'en'} href={canonicalURL} />
    <link rel="alternate" hreflang={locale === 'pt' ? 'en' : 'pt-BR'} href={alternateURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin)} />}

    <slot name="head" />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">{strings.skipToContent}</a>
    <Header locale={locale} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer azul={footerAzul} locale={locale} />
  </body>
</html>

<script>
  /*
    Revelação de título palavra por palavra: qualquer elemento com
    data-reveal-words tem seu texto quebrado em palavras, cada uma
    animando (opacidade + leve deslocamento) em sequência quando o
    título entra na viewport. Progressive enhancement: sem JS, ou com
    prefers-reduced-motion, o texto nunca é tocado — fica estático e
    legível desde o primeiro render, nunca escondido esperando o JS.
  */
  const motionAllowed = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (motionAllowed && 'IntersectionObserver' in window) {
    const headings = document.querySelectorAll<HTMLElement>('[data-reveal-words]');

    headings.forEach((heading) => {
      const text = heading.textContent ?? '';
      const words = text.split(/\s+/).filter(Boolean);
      heading.textContent = '';
      words.forEach((word, i) => {
        const span = document.createElement('span');
        span.className = 'reveal-word';
        span.textContent = word;
        span.style.transitionDelay = `${i * 45}ms`;
        heading.appendChild(span);
        if (i < words.length - 1) heading.appendChild(document.createTextNode(' '));
      });
      heading.classList.add('reveal-ready');
    });

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );

    headings.forEach((heading) => observer.observe(heading));
  }

  /*
    Blocos que entram com fade + leve deslocamento ao rolar a página:
    qualquer elemento com data-reveal-block. Mesmo progressive enhancement
    do reveal de palavras — sem JS/motion, o bloco nunca fica escondido.
  */
  if (motionAllowed && 'IntersectionObserver' in window) {
    const blocks = document.querySelectorAll<HTMLElement>('[data-reveal-block]');
    blocks.forEach((block) => block.classList.add('reveal-block-ready'));

    const blockObserver = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );

    blocks.forEach((block) => blockObserver.observe(block));
  }

  /*
    Contagem de 0 até o valor final, uma vez só, ao entrar na viewport —
    qualquer elemento com data-count (não precisa mais de um wrapper
    data-count-group específico, procura na página inteira).
  */
  if (motionAllowed && 'IntersectionObserver' in window) {
    const countEls = document.querySelectorAll<HTMLElement>('[data-count]');

    function animateCount(el: HTMLElement, duration = 1800) {
      const original = el.textContent?.trim() ?? '';
      const match = original.match(/^\d[\d.]*/);
      if (!match) return;
      const numStr = match[0];
      const suffix = original.slice(numStr.length);
      const target = parseInt(numStr.replace(/\./g, ''), 10);
      if (Number.isNaN(target)) return;

      const start = performance.now();

      function frame(now: number) {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3); // ease-out cubic
        const current = Math.round(target * eased);
        el.textContent = current.toLocaleString('pt-BR') + suffix;
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          el.textContent = original; // garante o texto original exato ao final
        }
      }

      requestAnimationFrame(frame);
    }

    const countObserver = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.6 },
    );

    countEls.forEach((el) => countObserver.observe(el));
  }
</script>
