<script>
  const motionAllowed = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

  // ===== 1 · Números: os três cartões sobem e contam JUNTOS =====
  // (Antes entravam um a cada 700ms — a pedido, "as três fotos tão subindo em tempos diferentes": agora
  // todos começam no mesmo instante, com a mesma duração. O gatilho é 15% da lista visível: com 40% a lista
  // empilhada do celular — mais alta que a tela — podia nunca disparar e deixar os cartões invisíveis.)
  const numeros = document.querySelector<HTMLElement>('[data-numeros]');
  if (numeros && motionAllowed && 'IntersectionObserver' in window) {
    const itens = Array.from(numeros.querySelectorAll<HTMLElement>('[data-numero]'));
    numeros.classList.add('is-seq-ready');
    itens.forEach((it) => {
      const v = it.querySelector<HTMLElement>('[data-numero-valor]');
      if (v) v.textContent = '0';
    });

    function runSequence() {
      itens.forEach((it) => {
        const v = it.querySelector<HTMLElement>('[data-numero-valor]');
        const target = Number(v?.dataset.target ?? '0');
        const duration = 800;
        it.classList.add('is-on');
        const start = performance.now();
        function frame(now: number) {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          if (v) v.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      });
    }

    const obs = new IntersectionObserver(
      (entries, o) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            runSequence();
            o.disconnect();
          }
        });
      },
      { threshold: 0.15 },
    );
    obs.observe(numeros);
  }

  // ===== 2 · Painel da base teórica (os cartões viram só por CSS, no hover/foco) =====

  function bindDisclosure(toggleSel: string, panelSel: string) {
    const toggle = document.querySelector<HTMLButtonElement>(toggleSel);
    const panel = document.querySelector<HTMLElement>(panelSel);
    if (!toggle || !panel) return;
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  }
  bindDisclosure('[data-base-toggle]', '[data-base-panel]');
  bindDisclosure('[data-metodologia-toggle]', '[data-metodologia]');

  // ===== Acordeão das Diretorias: abre/fecha com a técnica grid 0fr → 1fr =====
  function bindAccordion(itemSel: string, toggleSel: string, bodySel: string) {
    document.querySelectorAll<HTMLElement>(itemSel).forEach((item) => {
      const toggle = item.querySelector<HTMLButtonElement>(toggleSel);
      const body = item.querySelector<HTMLElement>(bodySel);
      if (!toggle || !body) return;
      body.setAttribute('inert', '');
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        body.classList.toggle('is-open', !open);
        if (open) body.setAttribute('inert', '');
        else body.removeAttribute('inert');
      });
    });
  }
  bindAccordion('[data-diretoria]', '[data-diretoria-toggle]', '.diretoria__corpo');

  // ===== 3 · Avatar que acompanha o scroll =====
  const atosRoot = document.querySelector<HTMLElement>('[data-atos]');
  if (atosRoot) {
    const fill = atosRoot.querySelector<HTMLElement>('[data-atos-fill]');
    const avatar = atosRoot.querySelector<HTMLElement>('[data-atos-avatar]');
    const paradas = Array.from(atosRoot.querySelectorAll<HTMLElement>('[data-atos-parada]'));
    const START = 100 / 6;
    const SPAN = (100 * 4) / 6;

    function render(p: number) {
      if (avatar) avatar.style.left = `${START + p * SPAN}%`;
      if (fill) fill.style.width = `${p * 100}%`;
      paradas.forEach((el, i) => el.classList.toggle('is-reached', p >= i / (paradas.length - 1) - 0.001));
    }

    if (!motionAllowed) {
      // Sem movimento: o avatar fica parado no primeiro ato, sem depender de scroll.
      render(0);
    } else {
      function onScroll() {
        const rect = atosRoot!.getBoundingClientRect();
        const vh = window.innerHeight;
        // 0 quando o bloco entra pela base da tela; 1 quando o topo dele chega perto do meio da tela
        // (o avatar termina a caminhada com a trilha ainda inteira à vista).
        const p = clamp((vh * 0.9 - rect.top) / (vh * 0.9 - vh * 0.45 + 0.0001), 0, 1);
        render(p);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    }
  }

  // ===== 4 · Mock do jogo da vida =====
  const jogoRoot = document.querySelector<HTMLElement>('[data-jogo]');
  const jogoDataEl = document.querySelector<HTMLScriptElement>('[data-jogo-data]');
  if (jogoRoot && jogoDataEl) {
    const data = JSON.parse(jogoDataEl.textContent ?? '{}') as {
      rodadas: { id: string; escolha: string; resultado: string; proxima: string; rodada2: { escolha: string; resultado: string }[] }[];
      inicio: string;
      nodes: Record<string, { x: number; y: number }>;
    };
    const fala = jogoRoot.querySelector<HTMLElement>('[data-fala]')!;
    const escolhas = jogoRoot.querySelector<HTMLElement>('[data-escolhas]')!;
    const avatar = jogoRoot.querySelector<HTMLElement>('[data-avatar]')!;
    const reiniciar = jogoRoot.querySelector<HTMLButtonElement>('[data-reiniciar]')!;
    const nodeEls = Array.from(jogoRoot.querySelectorAll<HTMLElement>('[data-node]'));
    const edgeEls = Array.from(jogoRoot.querySelectorAll<SVGLineElement>('[data-edge]'));

    function moveAvatar(id: string) {
      const pos = data.nodes[id];
      avatar.style.left = `${pos.x}%`;
      avatar.style.top = `${pos.y}%`;
    }

    function mark(path: string[]) {
      nodeEls.forEach((n) => {
        const id = n.dataset.node!;
        n.classList.toggle('is-traveled', path.includes(id));
        // Os ramos não escolhidos ficam esmaecidos: "escolher abre uns caminhos e fecha outros".
        const branch = path[1];
        n.classList.toggle('is-dim', path.length > 1 && id !== 'start' && !id.startsWith(branch));
      });
      edgeEls.forEach((e) => {
        const [from, to] = e.dataset.edge!.split('>');
        const i = path.indexOf(to);
        e.classList.toggle('is-traveled', i > 0 && path[i - 1] === from);
      });
    }

    function setButtons(labels: { label: string; handler: () => void }[]) {
      escolhas.innerHTML = '';
      labels.forEach(({ label, handler }) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'jogo__escolha';
        b.textContent = label;
        b.addEventListener('click', handler);
        escolhas.appendChild(b);
      });
    }

    function reset() {
      moveAvatar('start');
      mark(['start']);
      nodeEls.forEach((n) => n.classList.remove('is-dim'));
      fala.textContent = data.inicio;
      reiniciar.hidden = true;
      setButtons(data.rodadas.map((r) => ({ label: r.escolha, handler: () => choose1(r.id) })));
    }

    function choose1(id: string) {
      const r = data.rodadas.find((x) => x.id === id)!;
      moveAvatar(id);
      mark(['start', id]);
      fala.textContent = `${r.resultado} ${r.proxima}`;
      setButtons(r.rodada2.map((c, i) => ({ label: c.escolha, handler: () => choose2(id, i) })));
    }

    function choose2(id: string, i: number) {
      const r = data.rodadas.find((x) => x.id === id)!;
      const end = `${id}-${i}`;
      moveAvatar(end);
      mark(['start', id, end]);
      fala.textContent = r.rodada2[i].resultado;
      escolhas.innerHTML = '';
      reiniciar.hidden = false;
      reiniciar.focus();
    }

    // Os botões iniciais já vêm renderizados no servidor — religa com os mesmos handlers.
    escolhas.querySelectorAll<HTMLButtonElement>('[data-opcao]').forEach((b) => {
      b.addEventListener('click', () => choose1(b.dataset.opcao!));
    });
    reiniciar.addEventListener('click', reset);
  }

  // ===== 6 · Todos os quadros do antes/depois com a mesma altura (a do maior) =====
  function equalizeCaixas() {
    const caixas = Array.from(document.querySelectorAll<HTMLElement>('.comparativo__caixa'));
    caixas.forEach((c) => (c.style.minHeight = ''));
    const max = Math.max(0, ...caixas.map((c) => c.getBoundingClientRect().height));
    if (max > 0) caixas.forEach((c) => (c.style.minHeight = `${Math.ceil(max)}px`));
  }
  equalizeCaixas();
  window.addEventListener('resize', equalizeCaixas);
  if (document.fonts?.ready) document.fonts.ready.then(equalizeCaixas);

  // ===== 6 · Controle deslizante antes/depois =====
  document.querySelectorAll<HTMLElement>('[data-comparativo]').forEach((root) => {
    const slider = root.querySelector<HTMLInputElement>('[data-slider]');
    const caixa = root.querySelector<HTMLElement>('.comparativo__caixa');
    if (!slider || !caixa) return;
    function update() {
      const v = Number(slider!.value);
      const t = clamp((v - 42) / 16, 0, 1);
      caixa!.style.setProperty('--t', String(t));
      const isEn = document.documentElement.lang.startsWith('en');
      slider!.setAttribute('aria-valuetext', t === 0 ? (isEn ? 'Before' : 'Antes') : t === 1 ? (isEn ? 'After' : 'Depois') : isEn ? 'Between before and after' : 'Entre o antes e o depois');
    }
    slider.addEventListener('input', update);
    update();
  });
</script>
